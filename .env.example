# ==================================================================
# Modèle de configuration de production.
# Copie ce fichier en ".env" (qui ne doit JAMAIS être commité),
# puis remplace chaque valeur.
#
# Pour générer une valeur aléatoire solide, dans PowerShell :
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# ==================================================================

# Mot de passe de la base de données
POSTGRES_PASSWORD=a-remplacer

# Clé de signature des jetons JWT : au moins 32 octets, encodée en Base64
POKER_JWT_SECRET=a-remplacer

# Adresse publique du site (sans barre oblique finale)
POKER_ALLOWED_ORIGINS=http://localhost:8080
