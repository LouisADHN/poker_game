# ==================================================================
# Configuration du serveur : copie ce fichier en ".env" sur le serveur.
# Génère chaque secret directement sur le serveur avec :
#   openssl rand -base64 32
# ==================================================================

# Ton domaine, sans https:// ni barre oblique (ex : tapis-vert.duckdns.org)
DOMAIN=a-remplacer.duckdns.org

# Mot de passe de la base de données
POSTGRES_PASSWORD=a-remplacer

# Clé de signature des jetons JWT
POKER_JWT_SECRET=a-remplacer
